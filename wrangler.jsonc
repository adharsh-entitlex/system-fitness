{
  "name": "system-fitness",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // The hosted deployment injects its own APP_ORIGIN.
  // Secrets (OPENAI_API_KEY, VAPID_*, GOOGLE_*) belong in .dev.vars locally
  // and in Sites → Secrets once deployed — never in this file.
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "AI_BASE_URL": "https://freebuff.com/api/v1/paid",
    "AI_MODEL": "gpt-4o-mini"
  },
  // Water reminders while the app is closed. The client also asks the server
  // on open (/api/push/tick), so reminders survive hosts without cron.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-fitness",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
