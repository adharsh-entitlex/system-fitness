{
  "name": "system-fitness",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Public development client from `sites_enable_auth` (loopback only).
  // The hosted deployment gets its own values injected on deploy.
  "vars": {
    "FREEBUFF_CLIENT_ID": "5c1f5c36-ea22-4df0-8b69-90492942b0f0",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-fitness",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
