{
  "name": "system-fitness",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Water reminders while the app is closed. The client also asks the server
  // on open (/api/push/tick), so reminders survive hosts without cron.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-fitness",
      "database_id": "482f6087-5f62-4e38-be95-44b12ca8d691"
    }
  ],
  "observability": {
    "enabled": true
  }
}
