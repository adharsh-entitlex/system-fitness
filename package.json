{
  "name": "system-fitness",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Solo Leveling inspired fitness, hydration and nutrition tracker with accounts, pantry-aware AI meal plans, device notifications and an installable PWA shell.",
  "scripts": {
    "start": "node server/server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "vapid": "node scripts/make-vapid.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "wrangler dev",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:live": "node scripts/check-live.mjs",
    "test": "node scripts/test-app.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
