{
  "name": "THE SYSTEM — Fitness & Health",
  "short_name": "THE SYSTEM",
  "description": "Solo Leveling inspired personal fitness, hydration and nutrition tracker.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#05070f",
  "theme_color": "#05070f",
  "categories": ["health", "fitness", "lifestyle"],
  "shortcuts": [
    {
      "name": "Log 250 ml water",
      "short_name": "Water",
      "description": "Add a glass of water to today",
      "url": "/?quick=water",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Today's quest",
      "short_name": "Today",
      "description": "Open today's workout and directives",
      "url": "/?view=today",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Log weight",
      "short_name": "Weigh in",
      "description": "Record today's weight",
      "url": "/?quick=weigh",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
